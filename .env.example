# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FIRECRAWL_API_KEY=

# Widget API (/api/widget?key=...): shared key plus the demo account it reads
WIDGET_KEY=
DEMO_EMAIL=
DEMO_PASSWORD=

# Bank feed categoriser: local Ollama (unknown merchants). Unreachable from Vercel, falls back to "other".
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
